# Your config: profile, keywords, source list, and possibly an SMTP username.
config.yaml

# Third-party ATS dumps. CC BY-NC 4.0 — downloadable, not redistributable.
# See ats-data/README.md for where to get them.
ats-data/*.json

# Local state and output.
seen.db
seen.db-wal
seen.db-shm
*.db
digests/*

# A local folder of your own CV files, if you keep one beside your config.
# Never committed.
cvs/

# Credentials.
.env
.env.*
*.pem
*.key

# Tooling.
.venv/
__pycache__/
*.egg-info/
.mypy_cache/
.pytest_cache/
.ruff_cache/
.DS_Store

# Local handoff notes, not project documentation.
NEXT.md

# Lockfile: this is a library, not an application. Consumers resolve their own
# dependency tree; pinning ours here would be noise in every downstream diff.
# (A deployment that runs unattended does commit its lock.)
uv.lock
